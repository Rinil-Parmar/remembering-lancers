# Copy this file to .env.docker for local Docker testing.
# Do not commit .env.docker. Replace all secrets before running in production.

APP_ENV=production
APP_PORT=8000
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

SECRET_KEY=replace-with-a-secure-random-secret

POSTGRES_DB=remembering_lancers
POSTGRES_USER=remembering_lancers_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://remembering_lancers_app:replace-with-a-strong-database-password@db:5432/remembering_lancers

SCRAPER_MAX_PAGES=1
